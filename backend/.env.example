# Server Configuration
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# SMTP Configuration (Optional: if empty, OTP codes will be printed to server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CodeRank Support <noreply@coderank.local>"

# Optional Redis Modules Feature Flags
ENABLE_SEARCH_MODULE=false
ENABLE_BLOOM_MODULE=false
