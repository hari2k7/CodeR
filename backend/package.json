{
  "name": "coderank-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "CodeRank Backend - Real-time Competitive Programming Leaderboard with Redis as primary datastore",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker/judge.js",
    "seed": "node src/scripts/seed.js",
    "seed:reset": "node src/scripts/seed.js --reset",
